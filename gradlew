##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$(dirname "$0")

# Need to resolve $APP_HOME relative to the final app_path
APP_HOME=$(cd "$app_path" > /dev/null && pwd -P)

# Create the gradle wrapper directory if it doesn't exist
GRADLE_WRAPPER_DIR="$APP_HOME/gradle/wrapper"
if [ ! -d "$GRADLE_WRAPPER_DIR" ]; then
    mkdir -p "$GRADLE_WRAPPER_DIR"
fi

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# For Cygwin, ensure paths are in UNIX format before anything is touched
if cygpath -dc / | grep -q '^MSYS'; then
    APP_HOME=$(cygpath -w "$APP_HOME")
    DEFAULT_JVM_OPTS=$(cygpath -w "$DEFAULT_JVM_OPTS")
fi

# Set the Gradle wrapper jar file path
GRADLE_WRAPPER_JAR="$GRADLE_WRAPPER_DIR/gradle-wrapper.jar"

# Set the classpath for the Gradle wrapper
CLASSPATH="$GRADLE_WRAPPER_JAR"

# Set the main class for the Gradle wrapper
MAIN_CLASS="org.gradle.wrapper.GradleWrapperMain"

# Execute Gradle with the wrapper jar and main class
exec java $DEFAULT_JVM_OPTS -classpath "$CLASSPATH" "$MAIN_CLASS" "$@"

exit 1